--- !u!114 &1508115746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1508115745}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ca6a7998c82d6f4db0eef397d96a738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Whats that?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Its one of the 6 process we need to calibrate.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: How do we calibrate it?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: To activate it you have to push the Backspace Key Patch, but I press the
      Tab Key.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Seems pretty easy to me!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Well there is a bit more.  Once we activate it we need to press down space
      when the bar is in the GREEN area.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Okay got it! Anthing else I should know?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Well there is 3 levels per processer and if you fail a check you have to
      wait before you can try again so be careful!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Okay thanks Hit!
    customSound: {fileID: 0}
  iconUI: {fileID: 2090428741}
  dialogueUI: {fileID: 2013047141}
  audioSource: {fileID: 375174563}
  blipSound: {fileID: 8300000, guid: 401cb40fa3228434c8186aa3755b74eb, type: 3}
  volume: 1
  nextSceneName: 
  stayInScene: 1
  freezePlayers: 1
  uiToHide: []
