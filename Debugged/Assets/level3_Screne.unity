--- !u!114 &683689100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 683689097}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ca6a7998c82d6f4db0eef397d96a738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Its about to get really crazy out there so lets go over our attack!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Great idea! My base abilty is the Key O. I can use this at any time to
      defend my self!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: My base attack is Key E.  Then my special ability is Key Q but it has a
      cool down time so be smart! It puts a sheild around me so I can dodge all attacks!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: My special ability can heal myself or others using Key U! There is also
      a cool down!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Then there is my ultimate abilty using Left Shift! You have to work you
      way up to get this!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: My ultimate ability using Right Shift turns all enemys against each other!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Okay good recap! Now lets fight some glitches!!!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: YEA!!!!!!!!!!
    customSound: {fileID: 0}
  iconUI: {fileID: 683689099}
  dialogueUI: {fileID: 683689098}
  audioSource: {fileID: 375174563}
  blipSound: {fileID: 8300000, guid: 401cb40fa3228434c8186aa3755b74eb, type: 3}
  volume: 1
  nextSceneName: 
  stayInScene: 1
  freezePlayers: 1
