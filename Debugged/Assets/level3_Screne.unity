--- !u!114 &827746026
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 827746025}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ca6a7998c82d6f4db0eef397d96a738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "This is it. We're in the CPU \u2026 everything\u2019s unstable."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: What do we need to do?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Six processors are desynced. We need to recalibrate each one or the whole
      system crashes.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: "Be careful\u2014glitches hit harder here. The timing loops are breaking
      everything."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "Then we fix this fast. Let\u2019s get to work."
    customSound: {fileID: 0}
  iconUI: {fileID: 1490994572}
  dialogueUI: {fileID: 1036297748}
  audioSource: {fileID: 375174563}
  blipSound: {fileID: 8300000, guid: 401cb40fa3228434c8186aa3755b74eb, type: 3}
  volume: 1
  nextSceneName: 
  stayInScene: 1
  freezePlayers: 1
  uiToHide: []
