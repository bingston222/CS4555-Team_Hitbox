  m_Script: {fileID: 11500000, guid: 2ca6a7998c82d6f4db0eef397d96a738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 21300000, guid: ece00716074fef94790b08e163fe4320, type: 3}
    text: "System Voice: \u201CEntering Central Processing Unit. Clock synchronization
      error: 213% variance\r\ndetected.\u201D"
    customSound: {fileID: 8300000, guid: 3c7626465b6d6e64996fb1b01f43ec6f, type: 3}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Okay we made it lets make sure we-
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 39e42ae5f029a964db7ec661d66d7a73, type: 3}
    text: '*Friends Calling*'
    customSound: {fileID: 8300000, guid: c0d13aef29f34da45b716d5f344cf8a6, type: 3}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: Are you guys still alive?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: THEY DIED?!?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: You think they would pick up the phone if they were dead genius?... But
      you guys are okay tho right?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "Everything feels\u2026 slow and fast at the same time"
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: Oh great Hit is talking crazy
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: No Hit is right something feels off
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: I WANT TO SEE
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: This whole place looks like it skipped a few updates.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: "I don\u2019t like this! My jumps keep happening before I press the button!"
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: I think someone is just scared
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Ok guys we have to go. I have a feeling this is out last stop.
    customSound: {fileID: 0}
  iconUI: {fileID: 1805150641}
  dialogueUI: {fileID: 1474194785}
  audioSource: {fileID: 1042034473}
  blipSound: {fileID: 8300000, guid: 401cb40fa3228434c8186aa3755b74eb, type: 3}
  volume: 1
  nextSceneName: 
  stayInScene: 0
  freezePlayers: 1
  uiToHide:
  - {fileID: 152523467}
