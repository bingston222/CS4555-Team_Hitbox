      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.size
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: uiToHide.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: 'uiToHide.Array.data[0]'
      value: 
      objectReference: {fileID: 152523467}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "System Voice: \u201CEntering Central Processing Unit. Clock synchronization
        error: 213% variance\r\ndetected.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Okay we made it lets make sure we-
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[2].text
      value: '*Friends Calling*'
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Are you guys still alive?
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[4].text
      value: THEY DIED?!?
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[5].text
      value: You think they would pick up the phone if they were dead genius?...
        But you guys are okay tho right?
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[6].text
      value: "Everything feels\u2026 slow and fast at the same time"
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[7].text
      value: Oh great Hit is taking crazy
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[8].text
      value: No Hit is right something feels off
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[9].text
      value: I WANT TO SEE
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[10].text
      value: This whole place looks like it skipped a few updates.
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[11].text
      value: "I don\u2019t like this! My jumps keep happening before I press the
        button!"
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[12].text
      value: I think someone is just scared
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[13].text
      value: Ok guys we have to go. I have a feeling this is out last stop.
      objectReference: {fileID: 0}
    - target: {fileID: 3425901751346197384, guid: e712c1c79d58db944a4cf278dd65ddaf, type: 3}
      propertyPath: lines.Array.data[0].customSound
