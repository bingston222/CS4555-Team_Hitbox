  lines:
  - characterIcon: {fileID: 21300000, guid: 31c2ccf94db51944eb269ec3af3d18c4, type: 3}
    text: THE COMPUTER HAS BEEN SAVED!!!
    customSound: {fileID: 8300000, guid: 332e5d3219818c74f8994cd1e8403de0, type: 3}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "System integrity restored\u2026 whew! That was way too close."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: All corrupted processes terminated. Glitches neutralized. The computer
      is safe again!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: "We actually did it! All the skill checks, all the dodging\u2014 this was
      like\u2026 the hardest group project ever."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: Ummmm Byte... You werent there with them.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: HE WAS IN SPIRIT!
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: Oh brother...
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: And no one rage-quit for once! Proud of us.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Well those skill checks were REALLLYY annoying.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: "Let\u2019s send the final restore signal. On three"
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: "Reboot sequence\u2026 initialized."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: ece00716074fef94790b08e163fe4320, type: 3}
    text: 'SYSTEM MESSAGE: Core restored. Thank you, Hitbox & Friends!'
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: "Awwww it said thank you\u2026 I\u2019m gonna cry."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: Group hug before the next virus happens?
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: "Let\u2019s go home. We earned this."
    customSound: {fileID: 0}
