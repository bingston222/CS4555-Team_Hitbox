    text: 'Pathnote ...  Walk: IJKL  Run:N  Jump: H'
    voiceClip: {fileID: 8300000, guid: 61196a5699ffc734e94e58ae9789a488, type: 3}
    waitForInput: 0
    autoHold: 0.5
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: Okay guys check if your all still there.
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: hahaha ... maybe their not
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  calibrationDone:
  - characterIcon: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    text: Calibration Finalized
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Well that wasnt to bad
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: I guess they were all there :o
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: Of course, I built the Teleportation System
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: Not that good since their so far away
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  doorIntro:
  - characterIcon: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    text: 'ERRROORR

      sYSTEM  .. mODE  .. LoOkDowN'
    voiceClip: {fileID: 8300000, guid: 61196a5699ffc734e94e58ae9789a488, type: 3}
    waitForInput: 0
    autoHold: 0.5
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: Something out there has sensed you guys.
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: You will need to go though protocals to open doors in this zone.
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: See those two plates, you must both stand there at the same time
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  doorOpen:
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: Okay guys it might be dangerous out there, but we know you can do it
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Yes well come back soon
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Dont you worry about us, just start planning our return party
    voiceClip: {fileID: 0}
    waitForInput: 0
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  zoneB_Intro:
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Okay its me and you Patch
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Dont worry Hitbox ive got your back on anything
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Look at this its a skill check, these are the things that should be fixed.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Your right!!
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: You use [tab] Hitbox
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: 'I''ll use [delete]'
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
