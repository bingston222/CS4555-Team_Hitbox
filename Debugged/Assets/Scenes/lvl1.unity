--- !u!114 &1249339990
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1249339989}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d340a7ec6c7c4e15bc05637ffe2937f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    text: Warning. Data corruption at 92%. Firewall integrity compromised.
    voiceClip: {fileID: 8300000, guid: 61196a5699ffc734e94e58ae9789a488, type: 3}
    waitForInput: 0
    autoHold: 0.5
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: We spawned inside a bad sector. Cores look unstable.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: Agreed ... packet loss everywhere. Watch for input drift.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: Can you hear me alright? testing ... testing ... ok
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: Calibration is mandatory before you move. Your sensors are off by a few
      ticks.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: "Visual artifacts all around ... ghost fragments of deleted levels. Don\u2019t
      trust the floor."
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: Pushing the calibration module to your HUD now.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: "Copy. We\u2019ll run a baseline - movement, jump vector, and ability test."
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: "If something smells like static, that\u2019s normal-ish. Try not to lick
      anything."
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: '    . . . '
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "We\u2019ll keep comms clear. Patch, I\u2019ll call the steps ..."
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: Already queued. On your mark.
    voiceClip: {fileID: 0}
    waitForInput: 1
    autoHold: 0
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  - characterIcon: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    text: Calibration module ready.
    voiceClip: {fileID: 8300000, guid: 61196a5699ffc734e94e58ae9789a488, type: 3}
    waitForInput: 0
    autoHold: 0.4
    typewriterSpeed: 0
    panelFade: 0
    textFade: 0
  subtitleGroup: {fileID: 335215674}
  iconUI: {fileID: 1974747075}
  subtitleText: {fileID: 1247180148}
  audioSource: {fileID: 1249339991}
  crackleClip: {fileID: 8300000, guid: ca000da645d1c644da71c0d055f1e628, type: 3}
