--- !u!114 &1188242984
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188242983}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ca6a7998c82d6f4db0eef397d96a738, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - characterIcon: {fileID: 0}
    text: 'SYSTEM: Entering RAM sector. Memory usage at 97%. Cache overflow imminent.'
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 7bfa610f618f34e17906404a1d358d1d, type: 3}
    text: Friends calling!
    customSound: {fileID: 8300000, guid: 96d598cf1d3ec43acbb1b84c58acae3e, type: 3}
  - characterIcon: {fileID: 21300000, guid: 15f965f678b8ef54d8200897d01721d5, type: 3}
    text: This place looks like a fever dream made out of circuit boards.
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 3b7c54256ebfb3941b054c9942334773, type: 3}
    text: "Everything\u2019s unstable \u2014 one wrong move and this place collapses."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 81d262c64dd62704b9419beb7f3f00b4, type: 3}
    text: "And that hum? That\u2019s the memory clock trying to keep up with the
      overload."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: fb98fa2557843f04e87227ca42ac6028, type: 3}
    text: "It\u2019s making my head buzz\u2026 and I don\u2019t have a head."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: f058c26aa98edc14da9c117d7cce4814, type: 3}
    text: "Looks like the corruption\u2019s eating through the memory banks. We patch
      those\nleaks, we stabilize the core."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 21300000, guid: 8217982dbe280ee4f9e8422dd347963e, type: 3}
    text: "Stay alert. Rootkit\u2019s getting smarter. These leaks aren\u2019t random
      \u2014 they\u2019re designed."
    customSound: {fileID: 0}
  - characterIcon: {fileID: 0}
    text: 'SYSTEM: There are 6 memory leaks that need to be repaired in order to
      proceed. '
    customSound: {fileID: 0}
  iconUI: {fileID: 74461122}
  dialogueUI: {fileID: 1586638411}
  audioSource: {fileID: 270266139}
  blipSound: {fileID: 8300000, guid: 401cb40fa3228434c8186aa3755b74eb, type: 3}
  volume: 1
  nextSceneName: 
  stayInScene: 1
  freezePlayers: 1
